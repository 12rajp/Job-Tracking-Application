// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  user_id          Int               @id @default(autoincrement())
  user_name        String            @unique
  password         String
  email            String            @unique
  full_name        String?
  phone            String?
  profile_photo    String?
  city             String?
  country          String?
  date_of_birth    DateTime?
  gender           Gender?
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  Skill            Skill[]
  careerPreference CareerPreference?
  jobApplications  JobApplication[]
}

model Skill {
  skill_id       Int     @id @default(autoincrement())
  user_id        Int
  skill_name     String
  number_of_year Int?
  category       String?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model CareerPreference {
  pref_id       Int      @id @default(autoincrement())
  user_id       Int      @unique
  pref_industry String
  pref_role     String
  pref_location String?
  min_salary    Int?
  max_salary    Int?
  work_type     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model JobApplication {
  app_id               Int       @id @default(autoincrement())
  user_id              Int
  company_id           Int
  status_id            Int
  position_title       String
  job_description      String?
  job_link             String?
  location             String?
  job_type             String
  date_applied         DateTime
  application_deadline DateTime?
  salary_offered       Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  user    User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [company_id])
  status  Status  @relation(fields: [status_id], references: [status_id])

  @@index([user_id])
  @@index([company_id])
  @@index([status_id])
}

model Company {
  company_id   Int     @id @default(autoincrement())
 company_name   String
  industry     String?
  company_size String?
  location     String?
  rating       Float?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  jobApplications JobApplication[]
  contactHRs      Contact_HR[]
}

model Status {
  status_id Int    @id @default(autoincrement())
  status_name      String @unique

  jobApplications JobApplication[]
}

model Contact_HR {
  contact_id   Int      @id @default(autoincrement())
  company_id   Int
  hr_name      String
  email        String   @unique
  phone        String?
  position     String?
  linked_in    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  company Company @relation(fields: [company_id], references: [company_id], onDelete: Cascade)

  @@index([company_id])
}
