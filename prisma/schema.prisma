// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum NotificationMethod {
  EMAIL
  INAPP
  BOTH
}

enum InterviewType {
  ZOOM
  FACE_TO_FACE
}

enum DocumentType {
  RESUME
  COVER_LETTER
  OTHER
}


model User {
  user_id          Int               @id @default(autoincrement())
  user_name        String            @unique
  password         String
  email            String            @unique
  full_name        String?
  phone            String?
  profile_photo    String?
  city             String?
  country          String?
  date_of_birth    DateTime?
  gender           Gender?
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  userSkills       UserSkill[]
  careerPreference CareerPreference?
  jobApplications  JobApplication[]
  reminders Reminder[]
  documents Document[]
}

model Skill {
  skill_id   Int    @id @default(autoincrement())
  skill_name String @unique

  userSkills UserSkill[]
}

model UserSkill {
  id             Int    @id @default(autoincrement())
  user_id        Int
  skill_id       Int
  number_of_year Int?
  category       String?

  user  User  @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  skill Skill @relation(fields: [skill_id], references: [skill_id], onDelete: Cascade)

  @@unique([user_id, skill_id])
}

model CareerPreference {
  pref_id       Int      @id @default(autoincrement())
  user_id       Int      @unique
  pref_industry String
  pref_role     String
  pref_location String?
  min_salary    Int?
  max_salary    Int?
  work_type     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model JobApplication {
  app_id               Int       @id @default(autoincrement())
  user_id              Int
  company_id           Int
  status_id            Int
  position_title       String
  job_description      String?
  job_link             String?
  location             String?
  job_type             String
  date_applied         DateTime
  application_deadline DateTime?
  salary_offered       Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  user    User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [company_id])
  status  Status  @relation(fields: [status_id], references: [status_id])

 reminders   Reminder[]
  interviews  Interview[]
  documents   Document[]
  @@index([user_id])
  @@index([company_id])
  @@index([status_id])
}

model Company {
  company_id   Int     @id @default(autoincrement())
 company_name   String
  industry     String?
  company_size String?
  location     String?
  rating       Float?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  jobApplications JobApplication[]
  contactHRs      Contact_HR[]
}

model Status {
  status_id Int    @id @default(autoincrement())
  status_name      String 

  jobApplications JobApplication[]
}

model Contact_HR {
  contact_id   Int      @id @default(autoincrement())
  company_id   Int
  hr_name      String
  email        String   @unique
  phone        String?
  position     String?
  linked_in    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  company Company @relation(fields: [company_id], references: [company_id], onDelete: Cascade)

  @@index([company_id])
}

model Reminder {
  rem_id        Int      @id @default(autoincrement())
  user_id       Int
  app_id        Int
  reminder_at   DateTime
  message       String
  is_sent       Boolean  @default(false)
  method        NotificationMethod

  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user          User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  application   JobApplication @relation(fields: [app_id], references: [app_id], onDelete: Cascade)

  @@index([user_id])
  @@index([app_id])
}

model Interview {
  inter_id        Int      @id @default(autoincrement())
  app_id          Int
  round_num       Int
  interview_at    DateTime
  interview_type  InterviewType
  interviewer     String?
  location        String?
  duration        Int?     
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  application     JobApplication @relation(fields: [app_id], references: [app_id], onDelete: Cascade)

  @@index([app_id])
}

 model Document {
  doc_id       Int      @id @default(autoincrement())
  user_id      Int
  app_id       Int?    
  doc_name     String
  doc_type     String   
  file_path    String
  size         Int?     

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  
  user         User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  application  JobApplication? @relation(fields: [app_id], references: [app_id], onDelete: Cascade) 

  @@index([user_id])
  @@index([app_id])
}
